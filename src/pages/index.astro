---
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portofolio | Creative Developer</title>
  </head>
  <body class="bg-[#f5f5f3] text-[#141414] overflow-x-hidden selection:bg-[#141414] selection:text-[#f5f5f3]">
    
    <Navbar client:load />

    <main class="relative w-full">
      <Hero client:load />

      {/* SECTION: ABOUT */}
      <section 
        id="about" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight">About</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Area untuk menampilkan profil, latar belakang, dan keahlian teknis Anda.
          </p>
        </div>
      </section>

      {/* SECTION: PROJECT */}
      <section 
        id="project" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight">Project</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Area tempat menampilkan galeri karya dan studi kasus proyek terbaik.
          </p>
        </div>
      </section>

      {/* SECTION: ORGANISASI */}
      <section 
        id="organisasi" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight">Organisasi</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Area rekam jejak kepemimpinan dan pengalaman berorganisasi.
          </p>
        </div>
      </section>

      {/* SECTION: GALLERY */}
      <section 
        id="gallery" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight">Gallery</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Dokumentasi visual, momen penting, dan proyek kreatif lainnya.
          </p>
        </div>
      </section>

      {/* SECTION: CONTACT */}
      <section 
        id="contact" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight">Contact</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Formulir interaktif atau tautan sosial media untuk komunikasi langsung.
          </p>
        </div>
      </section>
    </main>

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    </script>
  </body>
</html>