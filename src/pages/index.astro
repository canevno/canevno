---
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import About from '../components/About.astro';
import Project from '../components/Project';
import Technology from '../components/Technology';
import Gallery from '../components/Gallery';
import Contact from '../components/Contact';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Evand Aprilliano</title>

    <script is:inline>
      (function () {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        try {
          var raw = sessionStorage.getItem('scroll-pos');
          var savedR = raw ? JSON.parse(raw).r : 0;
          if (location.hash.length > 1 || savedR > 0) {
            document.documentElement.classList.add('is-restoring');
            setTimeout(function () {
              document.documentElement.classList.remove('is-restoring');
            }, 8000);
          }
        } catch (e) {}
        document.documentElement.classList.add('dark');
      })();
    </script>
    <style is:inline>
      html.is-restoring main,
      html.is-restoring [data-site-nav] { visibility: hidden !important; }
      html.is-restoring *,
      html.is-restoring *::before,
      html.is-restoring *::after { transition: none !important; }

      html.lenis, html.lenis body { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto !important; }
      .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
      .lenis.lenis-stopped { overflow: hidden; }
      .lenis.lenis-scrolling iframe { pointer-events: none; }

      #stage,
      #stage > * { background-color: transparent !important; }
    </style>
  </head>
  <body class="w-full min-h-screen bg-[#EBECEE] dark:bg-black text-[#06151E] dark:text-white transition-colors duration-[400ms] overflow-x-hidden selection:bg-[#06151E] selection:text-white dark:selection:bg-white dark:selection:text-black">
    <Navbar client:load />

    <main class="relative w-full" id="main-content">
      <!--
        Tinggi hero diatur oleh Hero itu sendiri (dibekukan dari tinggi layar saat dimuat).
        Pembungkus ini sengaja TIDAK memakai h-[100dvh]: dvh berubah saat toolbar browser
        muncul/hilang dan membuat hero ikut membesar/mengecil.
      -->
      <div id="stage" class="relative w-full overflow-visible">
        <Hero client:load />
      </div>

      <div id="about">
        <About />
      </div>

      <div id="project">
        <Project />
      </div>

      <div id="technology">
        <Technology client:load />
      </div>

      <div>
        <Gallery client:load />
      </div>

      <div class="h-6 md:h-8"></div>
      <div>
        <Contact client:load />
      </div>
    </main>

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { initLandingAnimations, playHeroAnimations } from '../scripts/animations.js';

      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });

      const w = window;
      const html = document.documentElement;

      if (typeof w.__cleanupStage === 'function') w.__cleanupStage();

      const lenis = new Lenis({
        lerp: 0.1,
        smoothWheel: true,
      });
      w.__lenis = lenis;

      const tick = (time) => lenis.raf(time * 1000);
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(tick);
      gsap.ticker.lagSmoothing(0);

      const SCROLL_KEY = 'scroll-pos';
      let restored = false;
      let lenisAlive = true;
      let disposed = false;

      const mm = gsap.matchMedia();

      // Hero TIDAK lagi di-pin. Sebelumnya hero di-pin sepanjang 60% tinggi layar
      // (pin: true, end: '+=60%'): selama itu halaman terasa macet karena hero diam di tempat,
      // padahal hero sudah statis dan tidak ada animasi yang berjalan selama pin.
      // Pin juga mengunci ukuran stage sehingga ikut berubah saat tinggi layar berubah.

      mm.add('(prefers-reduced-motion: reduce)', () => {
        lenis.destroy();
        lenisAlive = false;
      });

      initLandingAnimations();

      const readSaved = () => {
        try {
          const raw = sessionStorage.getItem(SCROLL_KEY);
          if (!raw) return null;
          const r = JSON.parse(raw)?.r;
          return typeof r === 'number' && Number.isFinite(r) && r >= 0 ? r : null;
        } catch {
          return null;
        }
      };

      const savePos = () => {
        if (!restored) return;
        try {
          sessionStorage.setItem(SCROLL_KEY, JSON.stringify({ r: window.scrollY / window.innerHeight }));
        } catch {}
      };

      let saveT = 0;
      const scheduleSave = () => {
        if (!restored) return;
        clearTimeout(saveT);
        saveT = window.setTimeout(savePos, 150);
      };
      const offLenisScroll = lenis.on('scroll', scheduleSave);
      const onNativeScroll = () => scheduleSave();
      if (!lenisAlive) window.addEventListener('scroll', onNativeScroll, { passive: true });

      const onPageHide = () => savePos();
      const onVisibility = () => {
        if (document.visibilityState === 'hidden') savePos();
      };
      window.addEventListener('pagehide', onPageHide);
      document.addEventListener('visibilitychange', onVisibility);

      const getTarget = () => {
        const hash = location.hash;
        if (hash.length > 1) {
          let el = null;
          try {
            el = document.querySelector(hash);
          } catch {
            el = null;
          }
          if (el) return Math.max(0, el.getBoundingClientRect().top + window.scrollY - 64);
        }
        const r = readSaved();
        if (r !== null) return r * window.innerHeight;
        return 0;
      };

      const pageLoaded = new Promise((resolve) => {
        if (document.readyState === 'complete') resolve();
        else window.addEventListener('load', () => resolve(), { once: true });
      });
      const fontsReady = document.fonts?.ready ?? Promise.resolve();
      const waitFor = (cond, max = 2000) =>
        new Promise((resolve) => {
          const t0 = performance.now();
          const poll = () => {
            if (disposed || cond() || performance.now() - t0 >= max) resolve();
            else setTimeout(poll, 50);
          };
          poll();
        });
      const nextFrames = (n) =>
        new Promise((resolve) => {
          const step = (i) => (i <= 0 ? resolve() : requestAnimationFrame(() => step(i - 1)));
          step(n);
        });

      const failsafe = setTimeout(() => html.classList.remove('is-restoring'), 8000);

      const restoreScroll = async () => {
        await Promise.all([
          pageLoaded,
          fontsReady,
          waitFor(() => w.__navReady === true, 2000),
        ]);
        await nextFrames(2);
        if (disposed) return;

        ScrollTrigger.refresh();

        const target = getTarget();
        if (lenisAlive) {
          try {
            lenis.resize();
            lenis.scrollTo(target, { immediate: true, force: true });
          } catch {
            window.scrollTo({ top: target, left: 0, behavior: 'auto' });
          }
        } else {
          window.scrollTo({ top: target, left: 0, behavior: 'auto' });
        }
        ScrollTrigger.update();
        ScrollTrigger.getAll().forEach((st) => st.getTween()?.progress(1));
        window.dispatchEvent(new Event('scroll:restored'));

        if (lenisAlive) lenis.start();

        restored = true;
        requestAnimationFrame(() => {
          html.classList.remove('is-restoring');
          clearTimeout(failsafe);
        });
      };
      restoreScroll();

      fontsReady.then(() => {
        if (!disposed) ScrollTrigger.refresh();
      });

      const onPageShow = (e) => {
        if (e.persisted) ScrollTrigger.refresh();
      };
      window.addEventListener('pageshow', onPageShow);

      w.__cleanupStage = () => {
        disposed = true;
        clearTimeout(failsafe);
        clearTimeout(saveT);
        window.removeEventListener('pageshow', onPageShow);
        window.removeEventListener('pagehide', onPageHide);
        window.removeEventListener('scroll', onNativeScroll);
        document.removeEventListener('visibilitychange', onVisibility);
        try {
          offLenisScroll?.();
        } catch {}
        gsap.ticker.remove(tick);
        mm.revert();
        try {
          lenis.destroy();
        } catch {}
      };
    </script>
  </body>
</html>