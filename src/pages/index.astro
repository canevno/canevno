---
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portofolio | Evand Aprilliano</title>
  </head>
  <body class="bg-[#f5f5f3] text-[#141414] overflow-x-hidden selection:bg-[#141414] selection:text-white">
    
    <!-- NAVBAR -->
    <Navbar client:load />

    <!-- MAIN CONTENT (BERURUTAN TANPA DUPLIKASI) -->
    <main class="relative w-full bg-[#f5f5f3]">
      
      {/* 1. HERO SECTION */}
      <Hero client:load />

      {/* 2. ABOUT SECTION */}
      <section 
        id="about" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 bg-[#f5f5f3] scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#141414]">About</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Area profil dan latar belakang.
          </p>
        </div>
      </section>

      {/* 3. PROJECT SECTION */}
      <section 
        id="project" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 bg-[#f5f5f3] scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#141414]">Project</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Galeri karya dan proyek utama.
          </p>
        </div>
      </section>

      {/* 4. ORGANISASI SECTION */}
      <section 
        id="organisasi" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 bg-[#f5f5f3] scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#141414]">Organisasi</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Pengalaman dan rekam jejak organisasi.
          </p>
        </div>
      </section>

      {/* 5. GALLERY SECTION */}
      <section 
        id="gallery" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 bg-[#f5f5f3] scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#141414]">Gallery</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Dokumentasi visual dan momen penting.
          </p>
        </div>
      </section>

      {/* 6. CONTACT SECTION (SELESAI DI SINI) */}
      <section 
        id="contact" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 bg-[#f5f5f3] scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#141414]">Contact</h2>
          <p class="text-neutral-600 text-sm md:text-base">
            Formulir atau kontak sosial media.
          </p>
        </div>
      </section>

    </main>

    <!-- FOOTER PENUTUP HALAMAN -->
    <footer class="w-full py-8 text-center text-xs text-neutral-500 border-t border-neutral-300/60 bg-[#f5f5f3]">
      <p>© {new Date().getFullYear()} Evand Aprilliano. All rights reserved.</p>
    </footer>

    <!-- SCRIPT SMOOTH SCROLL LENIS & GSAP SINKRON -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Bersihkan instance ScrollTrigger lama saat Astro me-reload
      ScrollTrigger.getAll().forEach(t => t.kill());

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    </script>
  </body>
</html>