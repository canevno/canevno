---
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portofolio | Evand Aprilliano</title>

    {/* SCRIPT ANTI-FOUC: Mencegah efek layar berkedip saat pertama dimuat */}
    <script is:inline>
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="w-full min-h-screen bg-white dark:bg-[#0a0a0a] text-[#0a0a0a] dark:text-white transition-colors duration-400 overflow-x-hidden selection:bg-[#0a0a0a] selection:text-white dark:selection:bg-white dark:selection:text-[#0a0a0a]">
    
    <!-- NAVBAR -->
    <Navbar client:load />

    <!-- MAIN CONTENT -->
    <main class="relative w-full">
      
      <!-- 1. HERO SECTION -->
      <Hero client:load />

      <!-- 2. ABOUT SECTION -->
      <section 
        id="about" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#0a0a0a] dark:text-white transition-colors duration-400">About</h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base transition-colors duration-400">
            Area profil dan latar belakang.
          </p>
        </div>
      </section>

      <!-- 3. PROJECT SECTION -->
      <section 
        id="project" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#0a0a0a] dark:text-white transition-colors duration-400">Project</h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base transition-colors duration-400">
            Galeri karya dan proyek utama.
          </p>
        </div>
      </section>

      <!-- 4. ORGANISASI SECTION -->
      <section 
        id="organisasi" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#0a0a0a] dark:text-white transition-colors duration-400">Organisasi</h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base transition-colors duration-400">
            Pengalaman dan rekam jejak organisasi.
          </p>
        </div>
      </section>

      <!-- 5. GALLERY SECTION -->
      <section 
        id="gallery" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#0a0a0a] dark:text-white transition-colors duration-400">Gallery</h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base transition-colors duration-400">
            Dokumentasi visual dan momen penting.
          </p>
        </div>
      </section>

      <!-- 6. CONTACT SECTION -->
      <section 
        id="contact" 
        class="min-h-screen flex items-center justify-center px-4 md:px-8 scroll-mt-16"
      >
        <div class="max-w-4xl text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight text-[#0a0a0a] dark:text-white transition-colors duration-400">Contact</h2>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm md:text-base transition-colors duration-400">
            Formulir atau kontak sosial media.
          </p>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="w-full py-8 text-center text-xs text-neutral-500 dark:text-neutral-400 border-t border-neutral-300/60 dark:border-neutral-800 bg-white dark:bg-[#0a0a0a] transition-colors duration-400">
      <p>© {new Date().getFullYear()} Evand Aprilliano. All rights reserved.</p>
    </footer>

    <!-- SCRIPT SMOOTH SCROLL LENIS & GSAP -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.getAll().forEach(t => t.kill());

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    </script>
  </body>
</html>