---
// Ganti src dengan screenshot proyek Anda di public/preloader/. `bg` jadi warna cadangan.
const frames = [
  { src: '/preloader/1.webp', bg: '#1d4ed8' },
  { src: '/preloader/2.webp', bg: '#0f172a' },
  { src: '/preloader/3.webp', bg: '#e5322d' },
  { src: '/preloader/4.webp', bg: '#f5f5f4' },
  { src: '/preloader/5.webp', bg: '#065f46' },
  { src: '/preloader/6.webp', bg: '#4338ca' },
  { src: '/preloader/7.webp', bg: '#111827' },
  { src: '/preloader/8.webp', bg: '#0ea5e9' },
];
const bars = 10;
---

<script is:inline>
  (() => {
    try {
      const seen = localStorage.getItem('pl-seen') === '1';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seen || reduce) {
        document.documentElement.classList.add('pl-preloader-hidden');
      }
    } catch {
      // abaikan jika browser memblokir localStorage
    }
  })();
</script>

<div id="preloader" aria-hidden="true" class="fixed inset-0 z-[10000] overflow-hidden text-[#06151E] dark:text-white">
  <!-- Pita latar (yang menyapu saat keluar) -->
  <div class="absolute inset-0 flex">
    {Array.from({ length: bars }).map(() => (
      <div
        class="pl-bar h-full flex-none origin-top bg-[#EBECEE] dark:bg-black"
        style={`width:calc(${100 / bars}% + 1px);margin-right:-1px`}
      />
    ))}
  </div>

  <!-- Konten: [logo][gambar + counter][nama], rata tengah -->
  <div class="relative z-10 flex h-full w-full items-center justify-center" style="--pl-s:clamp(44px,6vw,76px)">
    <svg id="pl-mark" viewBox="0 0 48 48" fill="currentColor" class="flex-none" style="width:var(--pl-s);height:var(--pl-s)">
      <path d="M6 6h36v9H16v6h22v9H16v6h26v9H6z" />
    </svg>

    <div id="pl-media" class="flex-none overflow-hidden" style="width:0">
      <div class="flex w-max items-center gap-4 pl-4">
        <div class="relative overflow-hidden" style="height:calc(var(--pl-s)*1.5);aspect-ratio:1/1.04">
          {frames.map((f) => (
            <div
              class="pl-frame absolute inset-0 opacity-0"
              style={`background:${f.bg} url(${f.src}) center/cover no-repeat`}
            />
          ))}
        </div>
        <span id="pl-count" class="min-w-[3.4em] text-sm tabular-nums">[<span id="pl-num">0</span>%]</span>
      </div>
    </div>

    <div id="pl-name" class="flex-none overflow-hidden" style="width:0">
      <div class="w-max pl-3 font-bold uppercase leading-[0.92] tracking-tight" style="font-size:calc(var(--pl-s)*.46)">
        <span class="block overflow-hidden"><span class="pl-line block">Evand</span></span>
        <span class="block overflow-hidden"><span class="pl-line block">Aprilliano</span></span>
      </div>
    </div>
  </div>
</div>

<noscript><style>#preloader{display:none}</style></noscript>

<style>
  html.pl-preloader-hidden #preloader {
    display: none !important;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.getElementById('preloader');
  const html = document.documentElement;
  const w = window as any;

  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;
    try {
      seen = localStorage.getItem('pl-seen') === '1';
    } catch {
      seen = false;
    }
    if (reduce || seen) root.remove();
    else run(root);
  }

  function run(root: HTMLElement) {
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const mark = $('#pl-mark');
    const media = $('#pl-media');
    const name = $('#pl-name');
    const count = $('#pl-count');
    const num = $('#pl-num');
    const frames = Array.from(root.querySelectorAll<HTMLElement>('.pl-frame'));
    const lines = root.querySelectorAll('.pl-line');
    const bars = root.querySelectorAll('.pl-bar');

    // Kunci scroll sampai preloader selesai
    html.classList.add('is-loading');
    const lockLenis = () => (w.__lenis ? w.__lenis.stop() : requestAnimationFrame(lockLenis));
    lockLenis();

    // Keadaan awal
    gsap.set(mark, { opacity: 0, scale: 0.7, rotate: -14 });
    gsap.set(count, { opacity: 0 });
    gsap.set(lines, { yPercent: 110 });
    frames[0].style.opacity = '1';

    // Counter + pergantian gambar (potongan keras, tanpa crossfade)
    const state = { v: 0 };
    let last = 0;
    const paint = () => {
      num.textContent = String(Math.round(state.v));
      const i = Math.min(frames.length - 1, Math.floor((state.v / 100) * frames.length));
      if (i !== last) {
        frames[last].style.opacity = '0';
        frames[i].style.opacity = '1';
        last = i;
      }
    };

    const pageLoaded = new Promise<void>((r) =>
      document.readyState === 'complete' ? r() : window.addEventListener('load', () => r(), { once: true })
    );

    const startProgress = () => {
      // Merayap ke 90% (tampilan minimal ±1,6 dtk), lalu menunggu font + load
      const crawlDone = new Promise<void>((res) => {
        gsap.to(state, { v: 90, duration: 1.6, ease: 'none', onUpdate: paint, onComplete: res });
      });
      Promise.all([document.fonts.ready, pageLoaded, crawlDone]).then(() => {
        gsap.to(state, { v: 100, duration: 0.4, ease: 'none', onUpdate: paint, onComplete: outro });
      });
    };

    // FASE 1-3: logo masuk, celah gambar terbuka
    gsap
      .timeline({ delay: 0.3 })
      .to(mark, { opacity: 1, scale: 1, rotate: 0, duration: 0.7, ease: 'back.out(1.6)' })
      .to(media, { width: () => media.scrollWidth, duration: 0.5, ease: 'power3.out' }, '+=0.2')
      .to(count, { opacity: 1, duration: 0.2 }, '<0.15')
      .add(startProgress);

    // FASE 4-6: gambar menutup, nama terbuka, tahan, lalu pita menyapu
    function outro() {
      gsap
        .timeline({ onComplete: cleanup })
        .to(count, { opacity: 0, duration: 0.2 }, '+=0.35')
        .to(media, { width: 0, duration: 0.6, ease: 'power3.inOut' })
        .to(name, { width: () => name.scrollWidth, duration: 0.7, ease: 'power3.inOut' }, '<0.1')
        .to(lines, { yPercent: 0, duration: 0.7, ease: 'power4.out', stagger: 0.08 }, '<0.2')
        // tahan lockup ±0,7 dtk, lalu keluar
        .to(lines, { yPercent: -110, duration: 0.6, ease: 'power3.in', stagger: 0.06 }, '+=0.7')
        .to(name, { width: 0, duration: 0.6, ease: 'power3.inOut' }, '<0.1')
        .to(mark, { y: () => -(innerHeight / 2) + 40, scale: 0.55, duration: 0.8, ease: 'power4.inOut' }, '-=0.2')
        .to(bars, { scaleY: 0, duration: 0.9, ease: 'power4.inOut', stagger: { each: 0.05, from: 'random' } }, '-=0.3')
        .to(mark, { opacity: 0, duration: 0.3 }, '-=0.3');
    }

    function cleanup() {
      try {
        localStorage.setItem('pl-seen', '1');
      } catch {
        // abaikan jika browser memblokir localStorage
      }
      root.remove();
      html.classList.remove('is-loading');
      w.__lenis?.start();
      ScrollTrigger.refresh();
    }
  }
</script>